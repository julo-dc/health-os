# Copy to .env and fill in. Never commit the filled-in file.
# .env is gitignored; THIS file must only ever contain placeholders.

# ---- Database (Neon / Supabase / Vercel Postgres) ----
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# ---- Google OAuth (used for BOTH sign-in and the Google Health API) ----
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
# Must exactly match an Authorized redirect URI in Google Cloud Console
OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/callback

# ---- Access control: only these addresses may sign in (comma separated) ----
ALLOWED_EMAILS=you@example.com

# ---- Session signing secret: openssl rand -base64 32 ----
SESSION_SECRET=

# ---- OpenRouter (briefings, goal parsing, CSV reading, photo analysis) ----
OPENROUTER_API_KEY=
OPENROUTER_MODEL=z-ai/glm-5.3-flash
OPENROUTER_VISION_MODEL=z-ai/glm-5.3-flash
# Optional: preferred upstream provider(s), comma separated, in order
OPENROUTER_PROVIDER=
# Set false to pin strictly to the above (a busy provider then fails outright)
OPENROUTER_ALLOW_FALLBACKS=true
# low | medium | high — reasoning tokens bill as output; leave unset for default
# OPENROUTER_REASONING_EFFORT=medium

# ---- Protects /api/cron: openssl rand -hex 24 ----
CRON_SECRET=
